{
  "name": "mugen-history-and-stars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["extension", "server"],
  "scripts": {
    "dev": "bun run --filter '@mugen-history-and-stars/server' dev",
    "dev:extension": "bun run --filter '@mugen-history-and-stars/extension' dev",
    "build": "bun run build:extension && bun run build:server",
    "build:extension": "bun run --filter '@mugen-history-and-stars/extension' build",
    "build:server": "bun run --filter '@mugen-history-and-stars/server' build",
    "preview": "bun run --filter '@mugen-history-and-stars/server' preview",
    "db:gen": "bun run --filter '@mugen-history-and-stars/server' db:gen",
    "db:mg": "bun run --filter '@mugen-history-and-stars/server' db:mg"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~7.0.2"
  }
}
